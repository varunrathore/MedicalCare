
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model List<MedicalCare.Domain.Entities.Test>

<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Tests List</h4>
                    <div class="card-description text-end">
                        <button class="btn btn-primary" onclick="openCreateModal()">
                            + Add Test
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th> Test Name </th>
                                    <th> Category </th>
                                    <th> Price </th>
                                    <th> Duration </th>
                                    <th> Status </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var test in Model)
                                {
                                    <tr>
                                        <td class="py-1">@test.Name</td>
                                        <td>@test.Category?.Name</td>
                                        <td>$ @test.Price </td>
                                        <td>
                                            @{
                                                var h = test.DurationInMinutes / 60;
                                                var m = test.DurationInMinutes % 60;
                                            }
                                            @(h > 0 ? $"{h} hr {m} min" : $"{m} min")
                                        </td>
                                        <td>
                                            <button class="badge badge-warning" onclick="openEditModal('@test.Id')">Edit</button> |
                                            <a class="@(test.IsActive ? "badge badge-danger" : "badge badge-success") text-decoration-none" asp-action="ToggleStatus" asp-route-id="@test.Id">
                                                @(test.IsActive ? "Disable" : "Enable")
                                            </a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div id="modalContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function openCreateModal() {
        $.get('/Admin/Tests/Create', function (html) {
            showModal(html);
            bindForm('/Admin/Tests/Save');
        });
    }
    function openEditModal(id) {
        $.get(`/Admin/Tests/Edit?id=${id}`, function (html) {
            showModal(html);
            bindForm('/Admin/Tests/Save');
        });
    }
    function bindForm(url) {
        $('#categoryForm').submit(function (e) {
            e.preventDefault();

            $.post(url, $(this).serialize())
            .done(function () {
                location.reload();
            })
            .fail(function (xhr) {
                alert(xhr.responseText); // simple & effective
            });
        });
    }
    function showModal(html) {
        // Remove any existing modal & backdrop
        $('.modal').remove();
        $('.modal-backdrop').remove();

        $('#modalContainer').html(html);

        const modalEl = document.getElementById('categoryModalUnique');
        const modal = new bootstrap.Modal(modalEl, {
            backdrop: 'static',
            keyboard: false
        });

        modal.show();
    }
</script>

