@model MedicalCare.Presentation.ViewModels.Admin.TestCategoryModalVm
<div class="modal fade" id="categoryModalUnique" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">@(Model.IsEdit ? "Edit Category" : "Add Category")</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="categoryForm">
                <div class="modal-body">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="text"
                            name="Name"
                            class="form-control"
                            placeholder="Category Name"
                            value="@Model.Name" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>