
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model List<MedicalCare.Domain.Entities.TestCategory>

<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Striped Table</h4>
                    <div class="card-description text-end">
                        <button class="btn btn-primary" onclick="openCreateModal()">
                            + Add Category
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th> Name </th>
                                    <th> Status </th>
                                    <th> Action </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var category in Model)
                                {
                                    <tr>
                                        <td class="py-1">@category.Name</td>
                                        <td> @(category.IsActive ? "Active" : "Inactive") </td>
                                        <td>
                                            <button class="btn btn-sm btn-warning" onclick="openEditModal('@category.Id','@category.Name')">Edit</button> |
                                            <a asp-action="ToggleStatus" asp-route-id="@category.Id">
                                                @(category.IsActive ? "Disable" : "Enable")
                                            </a>
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                        <div id="modalContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function openCreateModal() {
        $.get('/Admin/TestCategory/Create', function (html) {
            showModal(html);
            bindForm('/Admin/TestCategory/Save');
        });
    }
    function openEditModal(id, name) {
        $.get(`/Admin/TestCategory/Edit?id=${id}&name=${name}`, function (html) {
            showModal(html);
            bindForm('/Admin/TestCategory/Save');
        });
    }
    function bindForm(url) {
        $('#categoryForm').submit(function (e) {
            e.preventDefault();

            $.post(url, $(this).serialize(), function () {
                location.reload(); // simple & effective
            });
        });
    }
    function showModal(html) {
        // Remove any existing modal & backdrop
        $('.modal').remove();
        $('.modal-backdrop').remove();

        $('#modalContainer').html(html);

        const modalEl = document.getElementById('categoryModalUnique');
        const modal = new bootstrap.Modal(modalEl, {
            backdrop: 'static',
            keyboard: false
        });

        modal.show();
    }
</script>


