
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model List<MedicalCare.Domain.Entities.TestCategory>
<style>
    .form-control:disabled {
        background-color: black !important;
    }
</style>
<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Test Category</h4>
                    <div class="card-description text-end">
                        <button class="btn btn-primary" onclick="openCreateModal()">
                            + Add Category
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th> Name </th>
                                    <th> Status </th>
                                    <th> Action </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var category in Model)
                                {
                                    <tr>
                                        <td class="py-1">@category.Name</td>
                                        <td> @(category.IsActive ? "Active" : "Inactive") </td>
                                        <td>
                                            <button class="badge badge-warning" onclick="openEditModal('@category.Id','@category.Name')">Edit</button> |
                                            @* @if (category.IsSystem()) *@
                                            @*     { *@
                                            @*         <a class="@(category.IsActive ? "badge badge-danger" : "badge badge-success") text-decoration-none" *@
                                            @*         href="javascript:void(0);" *@
                                            @*         title="System category cannot be changed"> *@
                                            @*             @(category.IsActive ? "Disable" : "Enable") *@
                                            @*         </a> *@
                                            @*         <span class="badge bg-secondary ms-2">System</span> *@
                                            @*     } *@
                                            @*     else *@
                                            @*     { *@
                                                    <a class="@(category.IsActive ? "badge badge-danger" : "badge badge-success") text-decoration-none" asp-action="ToggleStatus" asp-route-id="@category.Id" >
                                                        @(category.IsActive ? "Disable" : "Enable")
                                                    </a>
                                                @* } *@
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                        <div id="modalContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function openCreateModal() {
        $.get('/Admin/TestCategory/Create', function (html) {
            showModal(html);
            bindForm('/Admin/TestCategory/Save');
        });
    }
    function openEditModal(id, name) {
        $.get(`/Admin/TestCategory/Edit?id=${id}&name=${name}`, function (html) {
            showModal(html);
            bindForm('/Admin/TestCategory/Save');
        });
    }
    function bindForm(url) {
        $('#categoryForm').submit(function (e) {
            e.preventDefault();

            $.post(url, $(this).serialize())
            .done(function () {
                location.reload();
            })
            .fail(function (xhr) {
                alert(xhr.responseText); // simple & effective
            });
        });
    }
    function showModal(html) {
        // Remove any existing modal & backdrop
        $('.modal').remove();
        $('.modal-backdrop').remove();

        $('#modalContainer').html(html);

        const modalEl = document.getElementById('categoryModalUnique');
        const modal = new bootstrap.Modal(modalEl, {
            backdrop: 'static',
            keyboard: false
        });

        modal.show();
    }
</script>


